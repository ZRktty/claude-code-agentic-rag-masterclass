# Frontend environment variables (Vite + React)
#
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored — never commit real secrets.
#
# IMPORTANT: anything prefixed VITE_ gets bundled into the browser-shipped
# JS and is publicly visible. Only put values here that are safe for end
# users to see. Never put SUPABASE_SERVICE_ROLE_KEY or OPENAI_API_KEY here
# — those belong in backend/.env only.

# Same Supabase project as the backend. Supabase dashboard → Project
# Settings → API. Safe to expose: Row-Level Security is what actually
# protects user data, not secrecy of this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the local backend (Hono server) is running.
VITE_API_BASE_URL=http://localhost:3001
