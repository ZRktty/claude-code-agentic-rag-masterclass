# Backend environment variables (Hono + Bun server)
#
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored — never commit real secrets.

# Local port the Hono server listens on.
PORT=3001

# --- Supabase --------------------------------------------------------------
# Supabase dashboard → Project Settings → API.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# "anon" / "public" key. Safe to expose to end users (RLS protects the data),
# but the backend also uses it to build a per-request, user-scoped client
# (attaches the caller's access token so Postgres RLS policies apply).
SUPABASE_ANON_KEY=

# "service_role" key. Bypasses Row-Level Security entirely — treat like a
# root password. Used only as a documented admin escape hatch
# (backend/src/lib/supabase-admin.ts), not in normal request paths.
# NEVER prefix a frontend env var with this value — it must stay server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ------------------------------------------------------------------
# platform.openai.com → API keys.

OPENAI_API_KEY=

# Model id used for the Responses API calls (chat + file_search).
# Recommended: gpt-5.4-nano — OpenAI's cheapest current-gen model, still
# supports the Responses API + file_search tool. Good default for a chat
# app's general Q&A + retrieval traffic. Bump to gpt-5.4-mini if you need
# stronger reasoning for harder queries. Re-check platform.openai.com/docs/models
# at implementation time in case naming has moved on since this was written.
OPENAI_MODEL=gpt-5.4-nano

# --- LangSmith (observability) ---------------------------------------------
# smith.langchain.com → Settings → API Keys.

# Toggles tracing on/off.
LANGSMITH_TRACING=true

LANGSMITH_API_KEY=

# Project/workspace name traces get grouped under in the LangSmith dashboard.
# Created automatically on first trace if it doesn't already exist.
LANGSMITH_PROJECT=agentic-rag-masterclass
